{
  "name": "@envoymesh/envoy-harness-web",
  "version": "0.0.0",
  "description": "Browser WebUI host for envoy-harness (ACP over WebSocket).",
  "type": "module",
  "bin": {
    "envoy-harness-web": "./dist/server/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "dev": "tsx src/server/bin.ts --dev",
    "start": "tsx src/server/bin.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@envoymesh/envoy-harness": "file:../envoy-harness",
    "@envoymesh/envoy-harness-client": "file:../envoy-harness-client",
    "@envoymesh/envoy-harness-ehui": "file:../envoy-harness-ehui",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
