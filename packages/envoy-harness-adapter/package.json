{
  "name": "@envoymesh/envoy-harness-adapter",
  "version": "0.0.0",
  "description": "The reference MAP adapter for envoy-harness — bridges the home-team agent harness to EnvoyMesh's manifest broadcast, task submission, and the 3-tuple reputation book.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allenpeng0705/envoy-harness.git"
  },
  "bugs": {
    "url": "https://github.com/allenpeng0705/envoy-harness/issues"
  },
  "homepage": "https://github.com/allenpeng0705/envoy-harness#readme",
  "keywords": [
    "envoymesh",
    "agent",
    "harness",
    "mesh",
    "map",
    "adapter"
  ],
  "dependencies": {
    "@envoymesh/agent-adapter": "link:../../../EnvoyMesh/packages/agent-adapter",
    "@envoymesh/envoy-harness": "workspace:*",
    "@envoymesh/identity": "link:../../../EnvoyMesh/packages/identity",
    "@envoymesh/protocol": "link:../../../EnvoyMesh/packages/protocol"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
