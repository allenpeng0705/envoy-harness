{
  "name": "envoy-harness-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "envoy-harness monorepo — the home-team agent harness + adapters for EnvoyMesh.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "node scripts/build-workspace.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "verify": "pnpm run build && pnpm -r run typecheck && pnpm -r run test",
    "build:graph": "node scripts/build-workspace.mjs --graph",
    "envoy": "pnpm --filter @envoymesh/envoy-harness run envoy",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
